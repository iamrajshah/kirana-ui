{
  "name": "kirana-ui",
  "version": "1.0.0",
  "description": "Kirana POS SaaS - Mobile-first billing application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/write-release-manifest.mjs && npm run verify:production-bundle",
    "verify:production-bundle": "node scripts/verify-production-bundle.mjs dist",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "ionic:serve": "vite",
    "ionic:build": "vite build",
    "android:sync": "npm run build && cap sync android",
    "android:verify": "cd android && ./gradlew :app:testDebugUnitTest :app:lintDebug :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/barcode-scanner": "^4.0.1",
    "@capacitor/android": "^5.7.8",
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.7.8",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/share": "^5.0.8",
    "@capacitor/status-bar": "^5.0.6",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@ionic/react": "^7.6.2",
    "@ionic/react-router": "^7.6.2",
    "@react-pdf/renderer": "^4.9.0",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.6.5",
    "i18next": "^23.7.13",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.2",
    "ionicons": "^7.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-redux": "^9.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.10.7",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/react-router": "^5.1.20",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "@stencil/core": "4.12.2"
  }
}
